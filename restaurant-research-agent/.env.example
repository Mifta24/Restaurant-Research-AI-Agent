GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEET_WEBHOOK_SECRET=change-me-before-deploy

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=FTS Restaurant AI Agent
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_NOTES=20

ENABLE_DIAGNOSIS_AGENT=false
DIAGNOSIS_USE_AI=true
DIAGNOSIS_MODEL=openai/gpt-4o-mini
DIAGNOSIS_FALLBACK_MODEL=
DIAGNOSIS_MAX_LEADS=20
DIAGNOSIS_TEMPERATURE=0.2
DIAGNOSIS_MAX_TOKENS=700
ENABLE_SALES_MESSAGE_AGENT=false
SALES_MESSAGE_USE_AI=true
SALES_MESSAGE_MODEL=openai/gpt-4o-mini
SALES_MESSAGE_FALLBACK_MODEL=
SALES_MESSAGE_MAX_LEADS=20
SALES_MESSAGE_TEMPERATURE=0.45
SALES_MESSAGE_MAX_TOKENS=1200

BATCH_LIMIT=50
TARGET_AREAS=Kemang,Senopati,SCBD
ENABLE_AI_NOTES=false
ENABLE_CRON=false
CRON_SCHEDULE=0 9 * * *
